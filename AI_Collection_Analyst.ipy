# Work from the folder where this script is saved,
# so the Excel file, database, reports and images are found from any terminal folder
os.chdir(os.path.dirname(os.path.abspath(__file__)))


# ======================================================================
# OpenAI and email setup
# ======================================================================
load_dotenv(override=True)

openai_api_key = os.getenv("OPENAI_API_KEY")
MODEL = "gpt-4.1-mini"
