"""
AI Collection Analyst - RMS Software Trading

Job / role: Accounts Receivable collection officer
Task: Customer collection analysis (3 months of customer payments)
How often: 2 times a week

Run:  python AI_Collection_Analyst.py
Needs a .env file with OPENAI_API_KEY, EMAIL_ADDRESS and EMAIL_PASSWORD,
and the Excel file Customer_Payments_Collection_Register_3Months.xls
in the same folder as this script.
"""


# ======================================================================
# Imports
# ======================================================================
